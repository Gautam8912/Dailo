# Food Express — environment variables (optional)
#
# The React app needs NO environment variables: all demo data lives in
# localStorage. These are only used if you also run the optional Express API
# in backend/ (a MongoDB URI and a JWT secret).
#
# Copy this file to backend/.env and fill it in only if you want the real API.

MONGO_URI=mongodb://127.0.0.1:27017/food_express
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
