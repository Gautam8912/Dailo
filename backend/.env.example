# ---------------------------------------------------------------------------
# Food Express API — environment template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# MongoDB connection string (required for the API to start in backend mode).
# Local:    mongodb://127.0.0.1:27017/foodexpress
# Atlas:    mongodb+srv://<user>:<password>@<cluster>/foodexpress
MONGO_URI=mongodb://127.0.0.1:27017/foodexpress

# JSON Web Token signing secret (required). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Access-token lifetime
JWT_EXPIRES_IN=7d

# HTTP port for the API (the storefront dev server proxies /api to this port)
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the storefront origin).
# Leave empty to allow same-origin/relative requests only.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Rate limiting (per window, per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Seeded demo accounts (created by `npm run seed` when they do not exist yet).
# Change these before deploying anywhere public.
DEMO_ADMIN_EMAIL=admin@foodexpress.com
DEMO_ADMIN_PASSWORD=admin123
DEMO_USER_EMAIL=user@test.com
DEMO_USER_PASSWORD=user123
SEED_DEMO_ACCOUNTS=true

# ---------------------------------------------------------------------------
# Payments — NOT configured in this build.
# The API records a clearly labelled "demo" payment and cash-on-delivery only.
# To accept real money, integrate a supported gateway and verify its signature
# server-side in backend/src/services/payment.service.js before marking an
# order paid. The storefront never declares a payment successful on its own.
# ---------------------------------------------------------------------------
PAYMENT_MODE=demo
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional: email provider for real password resets (not configured here).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Food Express <no-reply@foodexpress.demo>"

# Run the API without MongoDB (CI/demos only). Health checks and the seeded
# catalogue fallback are served; every write route answers 503 honestly.
ALLOW_WITHOUT_DATABASE=false
