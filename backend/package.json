{
  "name": "food-express-api",
  "version": "3.0.0",
  "private": true,
  "description": "Optional Express + MongoDB API for Food Express. The React app does not need this to run — it uses localStorage. Keep it if you want a real server for your project demo.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "seed": "node seed/seed.js",
    "nod": "ALLOW_WITHOUT_DATABASE=true node src/server.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  }
}
